---
import { dicts, locales, localeNames, localePath, type Locale } from '../i18n'
import { repoUrl } from '../lib/release'

interface Props {
  locale: Locale
  path?: string
}

const { locale, path = '' } = Astro.props
const t = dicts[locale]
---

<footer class="bg-mist px-6 pt-4 pb-8 text-[12px] leading-[1.33] text-gray">
  <div class="mx-auto max-w-[980px]">
    <p class="border-b border-black/10 py-4">{t.footer.note}</p>
    <div class="flex flex-col gap-3 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <p>
        {t.footer.made} <a href="https://productdevbook.com" class="text-ink/80 hover:underline">productdevbook</a>
        <span class="mx-2 text-black/20">|</span><a href={`${repoUrl}/blob/main/LICENSE`} class="text-ink/80 hover:underline">{t.footer.license}</a>
        <span class="mx-2 text-black/20">|</span><a href={repoUrl} class="text-ink/80 hover:underline">GitHub</a>
        <span class="mx-2 text-black/20">|</span><a href={`${repoUrl}/releases`} class="text-ink/80 hover:underline">{t.footer.releases}</a>
      </p>
      <nav aria-label={t.footer.language} class="flex gap-4">
        {locales.map((l) => (
          <a href={localePath(l) + path} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined} class:list={['hover:underline', l === locale ? 'text-ink' : 'text-ink/60']}>
            {localeNames[l]}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

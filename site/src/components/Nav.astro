---
import { dicts, localePath, type Locale } from '../i18n'
import { latestRelease } from '../lib/release'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dicts[locale]
const home = localePath(locale)
const release = await latestRelease()
---

<header class="vibrant sticky top-0 z-50 border-b border-black/10">
  <nav class="mx-auto flex h-[52px] max-w-[1080px] items-center justify-between px-6">
    <a href={home} class="text-[21px] font-semibold tracking-[-0.01em]">iPhone Audio</a>
    <div class="flex items-center gap-6 text-[12px]">
      <a href={`${home}#setup`} class="hidden text-ink/80 hover:text-link sm:inline">{t.nav.setup}</a>
      <a href={`${home}#pricing`} class="hidden text-ink/80 hover:text-link sm:inline">{t.nav.pricing}</a>
      <a href={`${home}#faq`} class="hidden text-ink/80 hover:text-link sm:inline">{t.nav.faq}</a>
      <a href={release.download} class="rounded-full bg-blue px-[11px] py-[4px] text-white hover:bg-[#0077ed]">{t.nav.download}</a>
    </div>
  </nav>
</header>

---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Nav from './Nav.astro'
import Footer from './Footer.astro'
import { dicts, localePath, type Locale } from '../i18n'
import { latestRelease } from '../lib/release'
import icon from '../../../assets/icon-1024.png'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dicts[locale]
const release = await latestRelease()
---

<Base locale={locale} title={`${t.thanks.title} — iPhone Audio`} description={t.thanks.text} path="thanks/" noindex>
  <Nav locale={locale} />
  <main class="flex min-h-[78dvh] items-center justify-center px-6 py-28 text-center">
    <div class="reveal max-w-2xl">
      <Image src={icon} alt="" width={128} height={128} densities={[1, 2]} loading="eager" class="mx-auto size-28 rounded-[22.5%] shadow-[0_24px_48px_-16px_rgba(0,0,0,0.35)]" />
      <h1 class="display mt-10 text-[48px] sm:text-[80px]">{t.thanks.title}</h1>
      <p class="mt-4 text-[19px] text-gray sm:text-[21px]">{t.thanks.text}</p>
      <a href={release.download} class="mt-10 inline-block rounded-full bg-blue px-[22px] py-[11px] text-[17px] text-white transition hover:bg-[#0077ed]">
        {t.thanks.cta}{release.version && ` ${release.version}`}
      </a>
      <p class="mt-6 text-[14px] text-gray">{t.thanks.later}</p>
      <a href={localePath(locale)} class="mt-8 inline-block text-[17px] text-link hover:underline">{t.thanks.back} ›</a>
    </div>
  </main>
  <Footer locale={locale} path="thanks/" />
</Base>

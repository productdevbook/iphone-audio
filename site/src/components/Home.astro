---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Nav from './Nav.astro'
import Footer from './Footer.astro'
import MacScreen from './MacScreen.astro'
import { dicts, type Locale } from '../i18n'
import { latestRelease, checkoutUrl, repoUrl } from '../lib/release'
import icon from '../../../assets/icon-1024.png'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dicts[locale]
const release = await latestRelease()
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Nav locale={locale} />

  <main id="overview">
    <section class="bg-black px-4 pt-20 pb-16 text-center text-white sm:pt-28 sm:pb-24">
      <div >
        <h1 class="text-[21px] font-semibold tracking-[-0.01em] text-white/90 sm:text-[28px]">{t.hero.name}</h1>
        <p class="display mx-auto mt-2 max-w-4xl text-[48px] sm:text-[80px] md:text-[96px]">{t.hero.title}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
          <a href={release.download} class="rounded-full bg-blue px-[22px] py-[11px] text-[17px] text-white transition hover:bg-[#0077ed]">{t.hero.cta}</a>
          <a href={checkoutUrl} class="text-[17px] text-link-dark hover:underline">{t.hero.support} ›</a>
        </div>
        <p class="mt-6 text-[14px] text-white/55">
          {release.version && `${t.hero.version} ${release.version}. `}{t.hero.meta}
        </p>
      </div>
      <div class="mx-auto mt-14 max-w-[1200px] sm:mt-20">
        <MacScreen menu={t.menu} />
      </div>
    </section>

    <section class="px-6 py-28 sm:py-40">
      <p class="mx-auto max-w-[980px] text-[28px] leading-[1.14] font-semibold tracking-[-0.015em] text-gray sm:text-[40px] md:text-[48px] [&_strong]:font-semibold [&_strong]:text-ink" set:html={t.intro} />
    </section>

    <section class="bg-mist px-4 py-28 sm:py-36">
      <div class="mx-auto max-w-[1080px]">
        <h2 class="display px-2 text-[40px] sm:text-[64px]" set:html={t.specs.title} />
        <div class="mt-14 grid gap-5 sm:grid-cols-2">
          {t.specs.items.map((s, i) => (
            <div class="rounded-[28px] bg-white p-9 sm:p-12">
              <p class="display text-[96px] leading-none sm:text-[128px]">{s.big}</p>
              <p class="mt-2 text-[24px] font-semibold tracking-[-0.01em]">{s.unit}</p>
              <p class="mt-4 max-w-sm text-[17px] text-gray">{s.text}</p>
            </div>
          ))}
          <div class="flex flex-col justify-between gap-10 overflow-hidden rounded-[28px] bg-white p-9 sm:col-span-2 sm:flex-row sm:items-center sm:p-12">
            <div class="max-w-md">
              <h3 class="display text-[32px] sm:text-[40px]">{t.specs.follow.title}</h3>
              <p class="mt-4 text-[17px] text-gray">{t.specs.follow.text}</p>
            </div>
            <div class="w-full max-w-[340px] rounded-[18px] bg-mist p-3 text-[15px]" aria-hidden="true">
              <div class="flex items-center gap-3 rounded-[12px] px-3 py-2.5 text-gray"><span class="w-4"></span>MacBook Pro Speakers</div>
              <div class="flex items-center gap-3 rounded-[12px] bg-white px-3 py-2.5 shadow-sm"><span class="w-4 text-blue">✓</span><span class="font-medium">AirPods Pro</span></div>
              <div class="flex items-center gap-3 rounded-[12px] px-3 py-2.5 text-gray"><span class="w-4"></span>Studio Display</div>
            </div>
          </div>
          <div class="flex flex-col justify-between gap-10 rounded-[28px] bg-black p-9 text-white sm:col-span-2 sm:flex-row sm:items-center sm:p-12">
            <div class="max-w-md">
              <h3 class="display text-[32px] sm:text-[40px]">{t.specs.trust.title}</h3>
              <p class="mt-4 text-[17px] text-white/60">{t.specs.trust.text}</p>
              <a href={repoUrl} class="mt-6 inline-block text-[17px] text-link-dark hover:underline">GitHub ›</a>
            </div>
            <Image src={icon} alt="" width={200} height={200} densities={[1, 2]} class="size-36 rounded-[22.5%] sm:size-48" />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-black px-6 py-32 text-center text-white sm:py-44">
      <div class="mx-auto max-w-3xl">
        <span class="mx-auto block size-10 rounded-full bg-[#ff9f0a] shadow-[0_0_80px_20px_rgba(255,159,10,0.35)]"></span>
        <h2 class="display mt-14 text-[40px] sm:text-[64px]">{t.mic.title}</h2>
        <p class="mx-auto mt-6 max-w-2xl text-[19px] leading-[1.42] text-white/60 sm:text-[21px]">{t.mic.text}</p>
        <p class="mt-8 text-[14px] text-white/45">{t.mic.tip}</p>
      </div>
    </section>

    <section id="setup" class="scroll-mt-12 px-6 py-28 sm:py-40">
      <div class="mx-auto max-w-[1080px]">
        <h2 class="display text-[40px] sm:text-[64px]">{t.setup.title}</h2>
        <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
          {t.setup.steps.map((s, i) => (
            <li class="border-t border-black/15 pt-6">
              <span class="text-[14px] font-semibold text-gray">0{i + 1}</span>
              <p class="mt-3 text-[19px] leading-[1.4] text-gray"><strong class="font-semibold text-ink">{s.title}</strong> {s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="pricing" class="scroll-mt-12 bg-mist px-6 py-28 sm:py-40">
      <div class="mx-auto max-w-[980px] text-center">
        <h2 class="display text-[40px] sm:text-[64px]" set:html={t.pricing.title} />
        <p class="mx-auto mt-6 max-w-2xl text-[19px] text-gray sm:text-[21px]">{t.pricing.lead}</p>
        <div class="mt-16 grid gap-5 md:grid-cols-2">
          {[
            { p: t.pricing.free, from: '', href: release.download, primary: false },
            { p: t.pricing.paid, from: t.pricing.paid.from, href: checkoutUrl, primary: true },
          ].map(({ p, from, href, primary }, i) => (
            <div class="flex flex-col items-center rounded-[28px] bg-white px-8 py-12">
              <h3 class="text-[24px] font-semibold">{p.name}</h3>
              <p class="display mt-4 text-[48px]">{p.price}</p>
              <p class="mt-1 min-h-6 text-[14px] text-gray">{from}</p>
              <a href={href} class:list={['mt-6 rounded-full px-[22px] py-[11px] text-[17px] transition', primary ? 'bg-blue text-white hover:bg-[#0077ed]' : 'text-blue ring-1 ring-blue hover:bg-blue hover:text-white']}>{p.cta}</a>
              <ul class="mt-10 w-full max-w-xs text-[15px]">
                {p.points.map((pt) => <li class="border-t border-black/10 py-3.5">{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-8 text-[12px] text-gray">{t.pricing.note}</p>
      </div>
    </section>

    <section id="faq" class="scroll-mt-12 px-6 py-28 sm:py-40">
      <div class="mx-auto max-w-[980px]">
        <h2 class="display text-[40px] sm:text-[64px]">{t.faq.title}</h2>
        <div class="mt-14 border-b border-black/15">
          {t.faq.items.map((f) => (
            <details class="border-t border-black/15">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[21px] font-semibold tracking-[-0.01em] sm:text-[24px]">
                {f.q}
                <svg class="chev size-5 shrink-0 text-gray transition-transform duration-300" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg>
              </summary>
              <p class="max-w-3xl pb-7 text-[17px] text-gray sm:text-[19px]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="download" class="scroll-mt-12 bg-mist px-6 py-28 text-center sm:py-36">
      <div >
        <Image src={icon} alt="" width={128} height={128} densities={[1, 2]} class="mx-auto size-28 rounded-[22.5%] shadow-[0_24px_48px_-16px_rgba(0,0,0,0.35)]" />
        <h2 class="display mt-10 text-[40px] sm:text-[56px]">{t.cta.title}</h2>
        <p class="mt-3 text-[19px] text-gray sm:text-[21px]">{t.cta.text}</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
          <a href={release.download} class="rounded-full bg-blue px-[22px] py-[11px] text-[17px] text-white transition hover:bg-[#0077ed]">{t.hero.cta}</a>
          <a href={checkoutUrl} class="text-[17px] text-link hover:underline">{t.hero.support} ›</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>

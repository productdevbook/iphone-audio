---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Icon from './Icon.astro'
import Nav from './Nav.astro'
import Footer from './Footer.astro'
import Scene from './Scene.astro'
import { dicts, type Locale } from '../i18n'
import { latestRelease, checkoutUrl, repoUrl } from '../lib/release'
import icon from '../../../assets/icon-1024.png'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dicts[locale]
const release = await latestRelease()
const releaseDate = release.date?.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Nav locale={locale} />

  <main id="overview">
    <section class="relative overflow-hidden px-6 pt-36 pb-20 text-center sm:pt-44">
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] bg-[radial-gradient(60%_50%_at_50%_0%,rgba(0,113,227,0.14),transparent_70%)]"></div>
      <div class="reveal mx-auto max-w-4xl">
        <Image src={icon} alt="" width={112} height={112} densities={[1, 2]} loading="eager" class="mx-auto mb-8 size-24 rounded-[22%] shadow-[0_20px_50px_-12px_rgba(0,0,0,0.35)] sm:size-28" />
        <p class="eyebrow mb-4">{t.hero.eyebrow}</p>
        <h1 class="headline text-5xl sm:text-7xl md:text-8xl">
          <span class="block">{t.hero.title[0]}</span>
          <span class="text-gradient block pb-2">{t.hero.title[1]}</span>
        </h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-(--fg-mute) sm:text-xl">{t.hero.lead}</p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
          <a href={release.download} class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-[17px] font-medium text-white transition hover:bg-accent-hover active:scale-[0.98]">
            <Icon name="download" class="size-5" />{t.hero.cta}
          </a>
          <a href={checkoutUrl} class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-[17px] font-medium text-accent ring-1 ring-accent/40 transition hover:bg-accent/8 active:scale-[0.98]">
            <Icon name="heart" class="size-5" />{t.hero.support}
          </a>
        </div>
        <p class="mt-6 text-sm text-(--fg-mute)">
          {release.version && <span>{t.hero.version} {release.version}{releaseDate && ` · ${releaseDate}`} · </span>}{t.hero.requirements}
        </p>
      </div>

      <div class="reveal mx-auto mt-20 max-w-5xl">
        <Scene />
      </div>
    </section>

    <section class="bg-(--bg-alt) px-6 py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl items-center gap-16 lg:grid-cols-2">
        <div class="reveal">
          <p class="eyebrow mb-3">{t.menu.eyebrow}</p>
          <h2 class="headline text-4xl sm:text-6xl">{t.menu.title}</h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-(--fg-mute) sm:text-xl">{t.menu.lead}</p>
        </div>
        <div class="reveal" aria-hidden="true">
          <div class="mx-auto max-w-md overflow-hidden rounded-2xl bg-(--card) shadow-[0_30px_80px_-30px_rgba(0,0,0,0.4)] ring-1 ring-(--hairline)">
            <div class="glass flex h-8 items-center justify-end gap-4 border-b border-(--hairline) px-4 text-[13px]">
              <span class="flex items-center gap-1 rounded-md bg-black/8 px-1.5 py-0.5 dark:bg-white/12">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M3.5 9a7 7 0 0 0 0 6M20.5 9a7 7 0 0 1 0 6" stroke-linecap="round" /></svg>
              </span>
              <span class="size-2 rounded-full bg-orange-500"></span>
              <span class="font-medium">9:41</span>
            </div>
            <div class="p-2 text-[14px]">
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="wave flex h-4 items-end gap-[3px]">
                  <span class="h-full w-[3px] rounded-full bg-accent"></span><span class="h-full w-[3px] rounded-full bg-accent"></span><span class="h-full w-[3px] rounded-full bg-accent"></span><span class="h-full w-[3px] rounded-full bg-accent"></span><span class="h-full w-[3px] rounded-full bg-accent"></span>
                </span>
                <span class="text-(--fg-mute)">{t.menu.status}</span>
              </div>
              <p class="px-3 text-[12px] leading-snug text-(--fg-mute)">{t.menu.note1}<br />{t.menu.note2}</p>
              <div class="my-2 h-px bg-(--hairline)"></div>
              <div class="flex items-center gap-2 rounded-md bg-accent px-3 py-1.5 text-white"><Icon name="check" class="size-4" />{t.menu.play}</div>
              <div class="my-2 h-px bg-(--hairline)"></div>
              <div class="flex items-center gap-2 px-3 py-1.5"><Icon name="check" class="size-4" />{t.menu.login}</div>
              <div class="flex items-center justify-between px-3 py-1.5 pl-9"><span>{t.menu.quit}</span><span class="text-(--fg-mute)">⌘Q</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="scroll-mt-16 px-6 py-28 sm:py-36">
      <div class="mx-auto max-w-6xl">
        <div class="reveal mx-auto max-w-3xl text-center">
          <p class="eyebrow mb-3">{t.how.eyebrow}</p>
          <h2 class="headline text-4xl sm:text-6xl">{t.how.title}</h2>
        </div>
        <ol class="mt-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.how.steps.map((s, i) => (
            <li class="reveal rounded-3xl bg-(--bg-alt) p-8" style={`transition-delay:${i * 80}ms`}>
              <span class="headline text-gradient text-5xl">{i + 1}</span>
              <h3 class="mt-6 text-xl font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-(--fg-mute)">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-(--bg-alt) px-6 py-28 sm:py-36">
      <div class="mx-auto max-w-6xl">
        <div class="reveal mx-auto max-w-3xl text-center">
          <p class="eyebrow mb-3">{t.features.eyebrow}</p>
          <h2 class="headline text-4xl sm:text-6xl">{t.features.title}</h2>
        </div>
        <div class="mt-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {t.features.items.map((f, i) => (
            <div class="reveal rounded-3xl bg-(--card) p-8 ring-1 ring-(--hairline)" style={`transition-delay:${(i % 3) * 80}ms`}>
              <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-accent/10 text-accent"><Icon name={f.icon} /></span>
              <h3 class="mt-6 text-xl font-semibold tracking-tight">{f.title}</h3>
              <p class="mt-2 leading-relaxed text-(--fg-mute)">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-28 sm:py-36">
      <div class="reveal mx-auto max-w-4xl text-center">
        <span class="mx-auto mb-8 block size-5 rounded-full bg-orange-500 shadow-[0_0_0_10px_rgba(249,115,22,0.15),0_0_0_22px_rgba(249,115,22,0.07)]"></span>
        <p class="eyebrow mb-3">{t.mic.eyebrow}</p>
        <h2 class="headline text-4xl sm:text-6xl">{t.mic.title}</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-(--fg-mute) sm:text-xl">{t.mic.text}</p>
        <p class="mx-auto mt-8 inline-block rounded-full bg-(--bg-alt) px-5 py-2.5 text-sm text-(--fg-mute)">{t.mic.tip}</p>
      </div>
    </section>

    <section id="pricing" class="scroll-mt-16 bg-(--bg-alt) px-6 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl">
        <div class="reveal mx-auto max-w-3xl text-center">
          <p class="eyebrow mb-3">{t.pricing.eyebrow}</p>
          <h2 class="headline text-4xl sm:text-6xl">{t.pricing.title}</h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-(--fg-mute)">{t.pricing.lead}</p>
        </div>
        <div class="mt-16 grid gap-6 md:grid-cols-2">
          <div class="reveal flex flex-col rounded-3xl bg-(--card) p-10 ring-1 ring-(--hairline)">
            <h3 class="text-lg font-semibold">{t.pricing.free.name}</h3>
            <p class="headline mt-3 text-5xl">{t.pricing.free.price}</p>
            <p class="mt-4 leading-relaxed text-(--fg-mute)">{t.pricing.free.text}</p>
            <ul class="mt-8 space-y-3">
              {t.pricing.free.points.map((p) => <li class="flex gap-3"><Icon name="check" class="size-5 shrink-0 text-accent" />{p}</li>)}
            </ul>
            <div class="mt-auto flex flex-wrap gap-3 pt-10">
              <a href={release.download} class="inline-flex items-center gap-2 rounded-full bg-(--fg) px-6 py-3 font-medium text-(--bg) transition hover:opacity-85"><Icon name="download" class="size-5" />{t.pricing.free.cta}</a>
              <a href={repoUrl} class="inline-flex items-center gap-2 rounded-full px-5 py-3 font-medium ring-1 ring-(--hairline) transition hover:bg-(--bg-alt)"><Icon name="github" class="size-5" />GitHub</a>
            </div>
          </div>
          <div class="reveal relative flex flex-col overflow-hidden rounded-3xl bg-(--card) p-10 ring-2 ring-accent" style="transition-delay:80ms">
            <div class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-[radial-gradient(circle,rgba(122,92,255,0.22),transparent_70%)]"></div>
            <h3 class="flex items-center gap-2 text-lg font-semibold"><Icon name="heart" class="size-5 text-[#ff5c8a]" />{t.pricing.paid.name}</h3>
            <p class="mt-3 flex items-baseline gap-3"><span class="headline text-5xl">{t.pricing.paid.price}</span><span class="text-sm text-(--fg-mute)">{t.pricing.paid.from}</span></p>
            <p class="mt-4 leading-relaxed text-(--fg-mute)">{t.pricing.paid.text}</p>
            <ul class="mt-8 space-y-3">
              {t.pricing.paid.points.map((p) => <li class="flex gap-3"><Icon name="check" class="size-5 shrink-0 text-accent" />{p}</li>)}
            </ul>
            <div class="mt-auto pt-10">
              <a href={checkoutUrl} class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-medium text-white transition hover:bg-accent-hover">{t.pricing.paid.cta}<Icon name="arrow" class="size-5" /></a>
            </div>
          </div>
        </div>
        <p class="reveal mt-8 text-center text-sm text-(--fg-mute)">{t.pricing.note}</p>
      </div>
    </section>

    <section id="faq" class="scroll-mt-16 px-6 py-28 sm:py-36">
      <div class="mx-auto max-w-3xl">
        <div class="reveal text-center">
          <p class="eyebrow mb-3">{t.faq.eyebrow}</p>
          <h2 class="headline text-4xl sm:text-6xl">{t.faq.title}</h2>
        </div>
        <div class="reveal mt-16 divide-y divide-(--hairline) border-y border-(--hairline)">
          {t.faq.items.map((f) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-medium">
                {f.q}
                <span class="chev text-2xl font-light text-(--fg-mute) transition-transform duration-300">+</span>
              </summary>
              <p class="pb-6 leading-relaxed text-(--fg-mute)">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="download" class="scroll-mt-16 px-6 pb-32">
      <div class="reveal relative mx-auto max-w-6xl overflow-hidden rounded-[36px] bg-black px-8 py-24 text-center text-white sm:py-32">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_50%_100%,rgba(41,151,255,0.35),transparent_70%)]"></div>
        <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} class="relative mx-auto mb-8 size-20 rounded-[22%]" />
        <h2 class="headline relative text-4xl sm:text-6xl">{t.cta.title}</h2>
        <p class="relative mt-5 text-lg text-white/70">{t.cta.text}</p>
        <div class="relative mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={release.download} class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-[17px] font-medium text-black transition hover:bg-white/90"><Icon name="download" class="size-5" />{t.hero.cta}</a>
          <a href={checkoutUrl} class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-[17px] font-medium text-white ring-1 ring-white/30 transition hover:bg-white/10"><Icon name="heart" class="size-5" />{t.hero.support}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
